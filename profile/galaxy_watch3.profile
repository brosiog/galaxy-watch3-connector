# Galaxy Watch3 (SM-R850, Tizen 5.5). These are also PebbleOS's built-in defaults.
runtime_dir = /opt/usr/home/owner/share/pebble
data_dir = /opt/usr/home/owner/share/pebble
input.keys = *power-keys, gpio_keys
input.touch = sec_touchscreen
input.bezel = tizen_detent
foreground_reclaim_ms = 700, 2000
